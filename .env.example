# Required — LLM inference (get a free key: https://console.groq.com/keys)
# Optional when LLM_BASE_URL below points at an endpoint that needs no auth
# (e.g. a local Ollama/LM Studio server) — the key also serves custom
# endpoints as their generic API key.
GROQ_API_KEY=your_groq_key_here

# Optional — Model configuration (defaults shown).
# The fallback ladder: primary -> fallback -> emergency. All three are
# validated against the live Groq catalog at startup; `llama-3.1-8b-instant`
# was decommissioned from the catalog (Nov 10 2026 live 404), so the
# emergency default is a verified-present model.
# PRIMARY_MODEL=openai/gpt-oss-120b
# FALLBACK_MODEL=openai/gpt-oss-20b
# EMERGENCY_MODEL=qwen/qwen3.8-27b

# Optional — Provider endpoint & timeout (MR5; defaults shown)
# LLM_BASE_URL=                        # Any OpenAI-compatible endpoint instead of Groq's official API:
#                                      #   Ollama    http://localhost:11434/v1
#                                      #   LM Studio http://localhost:1234/v1
#                                      #   OpenRouter https://openrouter.ai/api/v1
#                                      # When set, GROQ_API_KEY is optional (a local server needs no key)
#                                      # and the Groq-specific reasoning_effort parameter is omitted.
# LLM_TIMEOUT_SECONDS=120              # Hard cap per LLM call in seconds (hung calls used to stall the pipeline)

# Optional — Input limits (defaults shown)
# MAX_PDF_BYTES=5242880
# MAX_PDF_PAGES=8
# MAX_RESUME_CHARS=12000
# MAX_JOB_CHARS=6000
# MAX_FETCH_BYTES=1000000
# FETCH_TIMEOUT_SECONDS=8

# Optional — Scoring weights (defaults shown; must sum to 1.0)
# SCORE_THRESHOLD=80
# MAX_ITERATIONS=2
# ATS_SCORE_WEIGHT=0.6
# LLM_SCORE_WEIGHT=0.4

# Optional - LangSmith observability
# When enabled, traced payloads are PII-redacted client-side before they leave
# your machine: emails, phone numbers, and the candidate NAME parsed from the
# resume are masked on BOTH run inputs and outputs. Multi-name/bulk-export
# masking can be forced with REDACT_NAMES (comma-separated names); it also
# re-redacts already-stored data when scripts/export_langsmith_traces.py runs.
# resume CONTENT itself is still stored (it is the debug payload) - disable
# tracing in production for strict privacy.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=resume-optimizer
# REDACT_NAMES=Jane Roe, Alex Smith

# Optional — URL import allowlist (comma-separated domains).
# Job URL fetching is disabled until this is set, e.g.:
ALLOWED_JOB_URL_DOMAINS=boards.greenhouse.io,jobs.lever.co

# Optional — basic auth for public deployments (both required to enable).
# Without it, anyone who can reach the app can spend your quota.
#   APP_AUTH_*      -> server/app.py (FastAPI backend, used by the frontend + extension)
#   GRADIO_AUTH_*   -> app.py (legacy Gradio UI)
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
GRADIO_AUTH_USERNAME=
GRADIO_AUTH_PASSWORD=

# Optional — Browser extension mode
# The Chrome extension (see extension/README.md) may connect directly; the CORS
# regex below admits Chrome Web Store extension IDs (override for unpacked dev
# load). Users may also enter their own Groq key in the extension settings; it
# travels as an X-Groq-Api-Key header and overrides GROQ_API_KEY for that
# request (the server keeps fail-fast behavior on GROQ_API_KEY itself).
# EXTENSION_ORIGINS=^chrome-extension://[a-p0-9]{32}$

# Optional — Production storage & maintenance (defaults shown)
# CHECKPOINTER_DB_PATH=checkpoints.sqlite  # Set to persist graph state across restarts/multi-workers
# OUTPUT_ROOT=data/artifacts               # BB1 Phase B (PB1): where generated documents live. Default is the project's gitignored data/artifacts dir (survives OS temp cleaners, unlike the old %TEMP%/resume_optimizer_output); the 24h sweep still applies to files inside it
# RUNS_DB_PATH=                            # MR3 runs ledger (default OUTPUT_ROOT/runs.sqlite3, next to the artifacts). Holds run status, step-1 chips, and done-run result payloads (resume content at rest) for the 24h retention window; point at encrypted storage for strict-privacy deployments
# PROFILE_DB_PATH=data/profile.sqlite3     # BB1 application history (PERSISTENT by design: every completed run is auto-recorded with the JD + resume evidence, scores, and requirement-fit rows). Set to off to disable recording and keep the old 24h-ephemeral posture
# CLEANUP_INTERVAL_SECONDS=21600          # 6 hours (periodically purges stale request dirs)

# Optional — Startup behavior (server/app.py + legacy app.py)
# SKIP_STARTUP_HEALTHCHECK=1  # Skip the Groq provider health check at boot (offline dev / CI; the app still launches and runs fail fast)
