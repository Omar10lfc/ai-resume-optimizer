# Required — LLM inference (get a free key: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_key_here

# Optional — Model configuration (defaults shown)
# PRIMARY_MODEL=openai/gpt-oss-120b
# FALLBACK_MODEL=openai/gpt-oss-20b
# EMERGENCY_MODEL=llama-3.1-8b-instant

# Optional — Input limits (defaults shown)
# MAX_PDF_BYTES=5242880
# MAX_PDF_PAGES=8
# MAX_RESUME_CHARS=12000
# MAX_JOB_CHARS=6000
# MAX_FETCH_BYTES=1000000
# FETCH_TIMEOUT_SECONDS=8

# Optional — Scoring weights (defaults shown; must sum to 1.0)
# SCORE_THRESHOLD=80
# MAX_ITERATIONS=1
# ATS_SCORE_WEIGHT=0.6
# LLM_SCORE_WEIGHT=0.4

# Optional - LangSmith observability
# When enabled, traced payloads are PII-redacted client-side before they leave
# your machine: emails, phone numbers, and the candidate NAME parsed from the
# resume are masked on BOTH run inputs and outputs. Multi-name/bulk-export
# masking can be forced with REDACT_NAMES (comma-separated names); it also
# re-redacts already-stored data when scripts/export_langsmith_traces.py runs.
# resume CONTENT itself is still stored (it is the debug payload) - disable
# tracing in production for strict privacy.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=resume-optimizer
# REDACT_NAMES=Jane Roe, Alex Smith

# Optional — URL import allowlist (comma-separated domains).
# Job URL fetching is disabled until this is set, e.g.:
ALLOWED_JOB_URL_DOMAINS=boards.greenhouse.io,jobs.lever.co

# Optional — basic auth for public deployments (both required to enable).
# Without it, anyone who can reach the app can spend your Groq quota.
GRADIO_AUTH_USERNAME=
GRADIO_AUTH_PASSWORD=

# Optional — Production storage & maintenance (defaults shown)
# CHECKPOINTER_DB_PATH=checkpoints.sqlite  # Set to persist graph state across restarts/multi-workers
# CLEANUP_INTERVAL_SECONDS=21600          # 6 hours (periodically purges stale request dirs)
